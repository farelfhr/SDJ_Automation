{
  "name": "@sdj/worker",
  "version": "1.0.0",
  "description": "SDJ Assistant Background Worker",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sdj/domain": "workspace:*",
    "@sdj/contracts": "workspace:*",
    "@sdj/application": "workspace:*",
    "@sdj/infrastructure": "workspace:*",
    "@sdj/config": "workspace:*",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
