[Unit]
Description=SDJ public route filter
After=sdj-api.service

[Service]
User=sdj-proxy
Group=sdj-proxy
WorkingDirectory=/opt/sdj/current
ExecStart=/opt/sdj/node/bin/node scripts/serve-public.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=96M

[Install]
WantedBy=multi-user.target
