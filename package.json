{
  "name": "sdj-assistant",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "share": "node scripts/share.mjs",
    "export:shared-hosting": "node --import tsx scripts/export-shared-hosting.ts",
    "dev:api": "node --use-env-proxy --use-system-ca --conditions=development --import tsx apps/api/src/index.ts",
    "dev:worker": "node --use-env-proxy --use-system-ca --conditions=development --import tsx apps/worker/src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint apps packages tests scripts --no-warn-ignored",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "eval:ai": "node --use-env-proxy --use-system-ca --conditions=development --import tsx scripts/eval-ai.ts",
    "db:migrate": "node --conditions=development --import tsx scripts/migrate.ts",
    "db:status": "node --conditions=development --import tsx scripts/migrate.ts --status",
    "setup:runtime": "node --conditions=development --import tsx scripts/setup-runtime.ts",
    "demo": "node --conditions=development --import tsx scripts/demo.ts",
    "format:check": "prettier --check apps packages tests scripts",
    "format": "prettier --write apps packages tests scripts",
    "maintenance": "node --conditions=development --import tsx scripts/maintenance.ts",
    "openclaw": "node scripts/openclaw.mjs",
    "whatsapp:pair": "node scripts/run-pair.mjs"
  },
  "dependencies": {
    "@sdj/application": "workspace:*",
    "@sdj/config": "workspace:*",
    "@sdj/contracts": "workspace:*",
    "@sdj/domain": "workspace:*",
    "@sdj/infrastructure": "workspace:*",
    "@sdj/testing": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.20.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "zod": "3.25.76"
  }
}
