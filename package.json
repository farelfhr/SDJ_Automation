{
  "name": "sdj-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Personal spiritual activity tracker via WhatsApp",
  "homepage": "https://github.com/farelfhr/sdj-automation",
  "repository": {
    "type": "git",
    "url": "https://github.com/farelfhr/sdj-automation.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:watch": "pnpm -r run build:watch",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "db:migrate": "pnpm --filter @sdj/db run migrate",
    "db:migrate:rollback": "pnpm --filter @sdj/db run migrate:rollback",
    "db:seed": "pnpm --filter @sdj/db run seed",
    "db:studio": "pnpm --filter @sdj/db run studio",
    "dev:api": "pnpm --filter @sdj/api run dev",
    "dev:worker": "pnpm --filter @sdj/worker run dev",
    "dev:services": "docker compose up -d",
    "stop:services": "docker compose down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
