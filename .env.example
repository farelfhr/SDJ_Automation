# Salin ke .env utama. Hanya placeholder; jangan commit credential.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Untuk akses HTTPS dari perangkat lain; token hanya di .env utama.
NGROK_AUTHTOKEN=
PUBLIC_PROXY_PORT=3001
DATABASE_URL_APP=postgresql://sdj_app.PROJECT:PASSWORD@HOST:5432/postgres
DATABASE_URL_INGRESS=postgresql://sdj_ingress.PROJECT:PASSWORD@HOST:5432/postgres
DATABASE_URL_SCHEDULER=postgresql://sdj_scheduler.PROJECT:PASSWORD@HOST:5432/postgres
DATABASE_URL_MAINTENANCE=postgresql://sdj_maintenance.PROJECT:PASSWORD@HOST:5432/postgres
# Hanya migrasi/setup, tidak dibaca API atau worker.
DATABASE_URL_MIGRATOR=
# Tiga nilai acak berbeda, masing-masing 32 bytes hex.
ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
CHANNEL_HMAC_KEY=
CHANNEL_KEY_ID=main-v1
CHANNEL_ACCOUNT_ID=sdj-main
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=
AI_LIVE_ENABLED=true
SHEETS_LIVE_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL_V2=openai/gpt-oss-20b
GROQ_QUOTA_OWNER=groq-default
GROQ_LOCAL_RPM=1
GROQ_LOCAL_RPD=50
GEMINI_API_KEY=
GEMINI_MODEL_V2=gemini-3.5-flash-lite
GEMINI_QUOTA_OWNER=gemini-default
GEMINI_LOCAL_RPM=1
GEMINI_LOCAL_RPD=50
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_QUOTA_OWNER=nvidia-default
NVIDIA_LOCAL_RPM=1
NVIDIA_LOCAL_RPD=50
OPENROUTER_API_KEY=
# Only openrouter/free or a model ending in :free; paid models are rejected.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_QUOTA_OWNER=openrouter-default
OPENROUTER_LOCAL_RPM=5
OPENROUTER_LOCAL_RPD=50

# Enable only after migration, synthetic checks, and API/worker deployment.
REMINDERS_ENABLED=false
