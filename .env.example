# ===============================================
# SDJ Assistant - Environment Configuration
# ===============================================
# COPY THIS FILE TO .env.local AND .env.test
# NEVER commit .env files with real credentials!

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sdj_assistant
DATABASE_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT_MS=30000

# API Server
API_HOST=0.0.0.0
API_PORT=3000

# Worker
WORKER_CONCURRENCY=5
JOB_POLL_INTERVAL_MS=1000

# ===============================================
# AI Providers Configuration
# ===============================================

# Groq API (Primary - Fast)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.1

# Google Gemini (Fallback)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.1

# Zhipu GLM-4 (Secondary Fallback)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
GLM_MAX_TOKENS=1024
GLM_TEMPERATURE=0.1

# AI Quota Settings
AI_QUOTA_USER_PER_MINUTE=5
AI_QUOTA_USER_PER_DAY=50
AI_QUOTA_BUCKET_SIZE=1000
AI_QUOTA_REFILL_RATE=100

# ===============================================
# Google OAuth Configuration
# ===============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ===============================================
# WhatsApp / OpenClaw Configuration
# ===============================================
OPENCLAW_WEBHOOK_SECRET=
OPENCLAW_API_KEY=
OPENCLAW_INSTANCE_ID=your-instance-id

# ===============================================
# Security
# ===============================================
# Encryption key for sensitive data (32 bytes hex)
ENCRYPTION_KEY=
# HMAC key for message authentication
HMAC_KEY=

# ===============================================
# Feature Flags
# ===============================================
ENABLE_AI_INTERPRETATION=true
ENABLE_DEMO_MODE=false
