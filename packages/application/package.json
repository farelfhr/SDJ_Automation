{
  "name": "@sdj/application",
  "version": "1.0.0",
  "description": "Application layer - use cases and ports for SDJ Assistant",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p ../../tsconfig.check.json"
  },
  "dependencies": {
    "@sdj/contracts": "workspace:*",
    "@sdj/domain": "workspace:*"
  },
  "devDependencies": {}
}
